
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Required: app refuses to start without these ---
JWT_SECRET_KEY=
CNP_PEPPER=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Database ---
DATABASE_URL=

# --- OCR (leave empty if tesseract is on PATH, e.g. Docker) ---
TESSERACT_CMD=

# --- SMTP (email activation codes; dev mode prints to console if unset) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=MedRec

# --- Environment ---
ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=720
